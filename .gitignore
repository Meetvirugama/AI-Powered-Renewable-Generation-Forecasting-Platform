# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/
.env
*.env
# Hand-made copies such as .env.bak or .env.pre-forecast-cutover hold the same
# secrets as .env. A bare `.env` rule does not match them, so `git add .` on the
# server would have committed live API keys. Only the template is tracked.
.env.*
!.env.example

# Data & Models (too large for git — use S3)
data/raw/
data/processed/
models/*.pkl
models/*.pt
models/*.bin
*.parquet
*.csv
*.arrow
.cache/

# Notebooks checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
.docker/

# AWS / Terraform
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.example

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# MLflow
mlruns/
mlartifacts/

# Secrets — NEVER commit these
.env
.env.local
.env.production
secrets.yaml

# Local development artifacts
.coverage
.pytest_cache/
renewable.db
*.db
.venv/
regulations/chunks.jsonl
