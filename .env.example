# Database
DATABASE_URL=postgresql://user:password@localhost:5432/renewable

# API Security
PIPELINE_API_KEY=your_pipeline_api_key_here

# External APIs (Member 4)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# DSM Configuration
DSM_RULE_CONFIG=config/dsm_rules_2026.yaml

# S3 (Member 4)
S3_BUCKET_DATA=your-data-bucket
S3_BUCKET_MODELS=your-models-bucket

# App
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated allowed browser origins; add the CloudFront domain in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG Copilot (Member 4)
# mock = built-in canned responses; production = real retrieval + LLM
RAG_COPILOT_TYPE=mock
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
RAG_FALLBACK_MODEL=gemini/gemini-1.5-flash
RAG_TOP_K_FINAL=5
RAG_CACHE_TTL_SECONDS=3600
