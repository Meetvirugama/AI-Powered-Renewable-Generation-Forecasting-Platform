# Copy to .env and fill in. `cp .env.example .env && docker compose up` must
# give a working stack with nothing else edited -- if it does not, that is a bug
# in this file.
#
# Every variable the application reads is listed here, including ones that are
# empty by default. A variable the code reads but this file omits is how a
# deploy fails at 2am with a KeyError.
#
# On EC2 this file is generated from SSM Parameter Store by
# infra/docker/fetch_secrets.sh. Never commit a filled-in copy.

# ---- Database ----
# Inside docker compose the host is `db`; from the host it is localhost.
DATABASE_URL=postgresql+psycopg2://renewable:devpassword@localhost:5432/renewable
POSTGRES_PASSWORD=devpassword

# ---- App ----
APP_ENV=local                      # local | development | prod
LOG_LEVEL=INFO
# Comma-separated browser origins. Add the CloudFront domain here in prod, or
# every dashboard panel spins forever with a CORS error in the console.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth ----
# Protects POST /pipeline/run, which EventBridge calls nightly.
PIPELINE_API_KEY=change_me_local

# ---- RAG copilot ----
# mock       canned answers, no model, no network. The default so a fresh clone
#            runs with no API keys.
# production the real copilot: retrieval + LLM + guardrail.
RAG_COPILOT_TYPE=mock

GROQ_API_KEY=
GEMINI_API_KEY=
RAG_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
RAG_FALLBACK_MODEL=gemini/gemini-3.6-flash

# bge     the real bge-m3 model (needs requirements-ml.txt)
# mock    deterministic hash vectors, used by the test suite and CI
RAG_EMBED_BACKEND=bge
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# Candidates from each retriever, then the number that reach the prompt.
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_FINAL=5

# The reranker costs ~1 s per query on CPU. Set false to spend that on latency
# instead; RRF alone is decent.
RAG_ENABLE_RERANKER=true
RAG_CACHE_TTL_SECONDS=3600

# Where the baked model weights live inside the image. Do not change unless the
# Dockerfile changes with it.
HF_HOME=/models

# ---- DSM ----
DSM_RULE_CONFIG=config/dsm_rules_2026.yaml

# ---- Engine selection (mock until Member 1's models land) ----
FORECAST_ENGINE_TYPE=mock          # mock | production
OPTIMIZER_TYPE=mock                # mock | production

# ---- AWS (prod only; on EC2 these come from SSM) ----
AWS_REGION=ap-south-1
S3_BUCKET_DATA=
S3_BUCKET_MODELS=
# Set by the deploy workflow, consumed by docker-compose.prod.yml.
ECR_REGISTRY=
IMAGE_TAG=latest
